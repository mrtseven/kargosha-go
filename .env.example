# ── کارگشا Go — متغیرهای محیطی ───────────────────────────────
# این فایل را به .env.local کپی کنید و مقادیر را تنظیم کنید.
# همه متغیرها با NEXT_PUBLIC شروع می‌شوند و به کلاینت می‌روند؛
# هیچ رمز یا کلید محرمانه‌ای در این صفحه استفاده نمی‌شود.

# آدرس پایه همین صفحه (دامنه نهایی Vercel). برای canonical و متادیتای اشتراک‌گذاری.
# تا وقتی خالی باشد، canonical حذف می‌شود و صفحه بدون خطا کار می‌کند.
NEXT_PUBLIC_SITE_URL=

# سایت اصلی کارگشا (تأییدشده و زنده)
NEXT_PUBLIC_MAIN_SITE_URL=https://kar-gosha.ir

# نسخه وب کارگشا (تأییدشده و زنده)
NEXT_PUBLIC_WEB_APP_URL=https://app.kar-gosha.ir

# دانلود اپ اندروید (تأییدشده؛ همیشه به آخرین نسخه APK اشاره می‌کند)
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=https://kar-gosha.ir/api/landing/apk
